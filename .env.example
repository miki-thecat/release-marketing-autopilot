# Optional. Defaults to ./data/releases.
RELEASEFLOW_DATA_DIR=

# FFmpeg/ffprobe executable names or absolute paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional. Without a key, ReleaseFlow uses its deterministic local fallback.
OPENAI_API_KEY=

# Optional. The server uses the centralized default model when blank/omitted.
OPENAI_MODEL=

# Japanese is the development default. Change to en before global validation.
NEXT_PUBLIC_DEFAULT_LOCALE=ja
